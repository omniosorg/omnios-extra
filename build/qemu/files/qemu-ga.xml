<service_bundle type="manifest"
                name="qemu-ga">

    <service name="ooce/system/qemu-ga"
             type="service"
             version="1">

        <create_default_instance enabled="false" />

        <single_instance />

        <dependency name="filesystem-local"
                    grouping="require_all"
                    restart_on="none"
                    type="service">
            <service_fmri value="svc:/system/filesystem/local:default" />
        </dependency>

        <exec_method type="method"
                     name="start"
                     exec="/$(PREFIX)/bin/qemu-ga"
                     timeout_seconds="60"></exec_method>

        <exec_method type="method"
                     name="stop"
                     exec=":kill"
                     timeout_seconds="60"></exec_method>

        <property_group name="startd"
                        type="framework">
            <propval name="duration"
                     type="astring"
                     value="child" />
            <propval name="ignore_error"
                     type="astring"
                     value="core,signal" />
        </property_group>

        <stability value="Unstable" />

        <template>
            <common_name>
                <loctext xml:lang="C">QEMU guest agent</loctext>
            </common_name>
            <documentation>
                <manpage title="qemu-ga"
                         section="8"
                         manpath="/$(OPREFIX)/share/man" />
            </documentation>
        </template>

    </service>

</service_bundle>
