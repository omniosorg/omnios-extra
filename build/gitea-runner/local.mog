license LICENSE license=MIT

dir path=var/$(PREFIX) owner=$(USER) group=$(GROUP) mode=0700

group groupname=$(GROUP) gid=61
user ftpuser=false username=$(USER) uid=61 group=$(GROUP) \
    gcos-field="Gitea Actions runner" \
    home-dir=/var/$(PREFIX) password=NP

<transform file path=etc/$(PREFIX)/config.yaml -> set group $(GROUP)>
<transform file path=etc/$(PREFIX)/config.yaml -> set mode 0640>
<transform file path=etc/$(PREFIX)/config.yaml -> set preserve renamenew>

