license LICENSE.txt license=AGPLv3

dir group=bin mode=0755 owner=root path=var/$(PREFIX)
dir group=$(PROG) mode=0700 owner=$(PROG) path=var/$(PREFIX)/db
dir group=$(PROG) mode=0700 owner=$(PROG) path=var/log/$(PREFIX)
dir group=$(PROG) mode=0755 owner=$(PROG) path=etc/$(PREFIX)

group groupname=$(PROG) gid=64
user ftpuser=false username=$(PROG) uid=64 group=$(PROG) \
    gcos-field="Redis User" home-dir=/var/$(PREFIX) password=NP

file ./tmp/src/$(PROG).conf \
    path=etc/$(PREFIX)/$(PROG).conf \
    owner=$(PROG) group=$(PROG) mode=0644

<transform file path=etc/$(PREFIX) -> set preserve renamenew>

<include binlink.mog>

